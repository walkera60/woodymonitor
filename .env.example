# ============================================================
# Woody Monitor configuration
# ============================================================

# Serial connection to burner controller
# Find device with:
#   ls -l /dev/serial/by-id/
WOODY_SERIAL_DEVICE=/dev/ttyUSB0

# Web interface
WOODY_HOST=0.0.0.0
WOODY_PORT=8080

# MQTT
WOODY_MQTT_BROKER=localhost
WOODY_MQTT_PORT=1883
WOODY_MQTT_USERNAME=
WOODY_MQTT_PASSWORD=
WOODY_MQTT_TOPIC=woodymonitor
